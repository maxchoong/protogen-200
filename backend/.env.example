# Optional LLM configuration (GitHub Models retired July 30, 2026)
# OpenAI API credentials are separate from ChatGPT and GitHub Copilot subscriptions.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# For another OpenAI-compatible provider, set its key and API base URL together.
# LLM_API_KEY=
# LLM_BASE_URL=https://provider.example/v1

# OMDb API Configuration
# Free tier test key (for development only)
# Get dedicated key at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=trilogy

# TMDB API Configuration (Phase 4 - Trailers)
# Free tier available
# Get API key at: https://www.themoviedb.org/settings/api
# Optional alternative auth: TMDB Read Access Token (Bearer)
# TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_API_KEY=your_tmdb_api_key_here

# Streaming Availability API (Phase 4 - Where to Watch)
# Via RapidAPI, Free tier: 100 requests/day
# Sign up at: https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
RAPIDAPI_KEY=your_rapidapi_key_here

# Backend Configuration
PORT=3000
NODE_ENV=development

# TMDB Region (optional, defaults to US)
TMDB_REGION=US
