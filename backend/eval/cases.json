{
  "$comment": "Evaluation cases for the recommendation API. Turns are user messages; {choose, text} picks a clarification option by substring, or sends text if no question is pending. See memory-bank/design-conversational-engine.md.",
  "cases": [
    { "id": "korean-thriller-movies", "category": "constraint", "turns": ["Korean thriller movies"], "expect": { "clarify": false, "countries": ["KR"], "format": "movie", "anyGenre": ["Thriller", "Crime", "Mystery"] } },
    { "id": "japanese-anime-series", "category": "constraint", "turns": ["Japanese anime series"], "expect": { "clarify": false, "countries": ["JP"], "format": "tv", "anyGenre": ["Animation"] } },
    { "id": "french-romcoms", "category": "constraint", "turns": ["French romantic comedies"], "expect": { "clarify": false, "countries": ["FR"], "anyGenre": ["Romance", "Comedy"] } },
    { "id": "spanish-language-crime-shows", "category": "constraint", "turns": ["Spanish-language crime shows"], "expect": { "clarify": false, "languages": ["es"], "format": "tv", "anyGenre": ["Crime"] } },
    { "id": "bollywood-musicals", "category": "constraint", "turns": ["Bollywood musicals"], "expect": { "clarify": false, "countries": ["IN"], "anyGenre": ["Music", "Musical", "Romance", "Drama"] } },
    { "id": "nordic-noir", "category": "constraint", "turns": ["Nordic noir series"], "expect": { "clarify": false, "countries": ["SE", "DK", "NO", "IS", "FI"], "format": "tv", "anyGenre": ["Crime", "Mystery", "Drama"] } },
    { "id": "malaysian-movies", "category": "constraint", "turns": ["Malaysian movies"], "expect": { "countries": ["MY"], "format": "movie" } },
    { "id": "indonesian-horror", "category": "constraint", "turns": ["Indonesian horror films"], "expect": { "clarify": false, "countries": ["ID"], "anyGenre": ["Horror"] } },
    { "id": "thai-comedies", "category": "constraint", "turns": ["Thai comedies"], "expect": { "clarify": false, "countries": ["TH"], "anyGenre": ["Comedy"] } },
    { "id": "german-ww2", "category": "constraint", "turns": ["German films about World War II"], "expect": { "clarify": false, "countries": ["DE"], "anyGenre": ["War", "History", "Drama"] } },
    { "id": "italian-1960s", "category": "constraint", "turns": ["Classic Italian films from the 1960s"], "expect": { "clarify": false, "countries": ["IT"], "yearMin": 1960, "yearMax": 1969 } },
    { "id": "nineties-action", "category": "constraint", "turns": ["90s action movies"], "expect": { "clarify": false, "yearMin": 1990, "yearMax": 1999, "format": "movie", "anyGenre": ["Action"] } },
    { "id": "eighties-scifi", "category": "constraint", "turns": ["Sci-fi movies from the 80s"], "expect": { "clarify": false, "yearMin": 1980, "yearMax": 1989, "anyGenre": ["Science Fiction", "Sci-Fi"] } },
    { "id": "new-horror", "category": "constraint", "turns": ["new horror movies"], "expect": { "yearMin": 2025, "anyGenre": ["Horror"] } },
    { "id": "horror-this-month", "category": "constraint", "turns": ["horror movies released this month"], "expect": { "clarify": false, "yearMin": 2026, "anyGenre": ["Horror"], "minResults": 3 } },
    { "id": "dramas-2023", "category": "constraint", "turns": ["the best dramas from 2023"], "expect": { "clarify": false, "yearMin": 2023, "yearMax": 2023, "anyGenre": ["Drama"] } },
    { "id": "bingeable-scifi-series", "category": "constraint", "turns": ["a binge-worthy sci-fi TV series"], "expect": { "format": "tv", "anyGenre": ["Sci-Fi & Fantasy", "Science Fiction", "Sci-Fi"] } },
    { "id": "animated-kids-movie", "category": "constraint", "turns": ["an animated movie for young kids"], "expect": { "clarify": false, "format": "movie", "anyGenre": ["Animation", "Family"], "toneConflict": ["Horror", "War", "Thriller", "Crime"] } },
    { "id": "comedy-no-romance", "category": "constraint", "turns": ["comedy movies but no romance"], "expect": { "clarify": false, "excludeGenres": ["Romance"], "anyGenre": ["Comedy"] } },
    { "id": "thrillers-no-horror", "category": "constraint", "turns": ["thrillers, no horror please"], "expect": { "clarify": false, "excludeGenres": ["Horror"], "anyGenre": ["Thriller"] } },
    { "id": "family-not-animated", "category": "constraint", "turns": ["family movies that aren't animated"], "expect": { "clarify": false, "excludeGenres": ["Animation"], "anyGenre": ["Family"] } },

    { "id": "something-heartwarming", "category": "tone", "turns": ["something heartwarming"], "expect": { "toneConflict": ["Horror", "War", "Thriller", "Crime"] } },
    { "id": "cosy-show", "category": "tone", "turns": ["a relaxing, cosy show to unwind with"], "expect": { "format": "tv", "toneConflict": ["Horror", "War", "Thriller", "Crime"] } },
    { "id": "funny-horror", "category": "tone", "turns": ["funny horror movies"], "expect": { "clarify": false, "allGenres": ["Horror", "Comedy"], "allGenresShare": 0.5 } },
    { "id": "gritty-crime", "category": "tone", "turns": ["gritty crime thrillers and mysteries"], "expect": { "anyGenre": ["Crime", "Thriller", "Mystery"], "toneConflict": ["Family", "Animation"] } },
    { "id": "feel-good-sports", "category": "tone", "turns": ["feel-good sports movies"], "expect": { "toneConflict": ["Horror", "War", "Thriller"] } },
    { "id": "sad-cry", "category": "tone", "turns": ["a sad movie that will make me cry"], "expect": { "anyGenre": ["Drama", "Romance"], "toneConflict": ["Horror", "Action"] } },
    { "id": "date-night", "category": "tone", "turns": ["a romantic movie for date night"], "expect": { "anyGenre": ["Romance"], "toneConflict": ["Horror", "War"] } },
    { "id": "dark-psych-thriller", "category": "tone", "turns": ["dark psychological thrillers"], "expect": { "anyGenre": ["Thriller", "Mystery", "Horror", "Crime"], "toneConflict": ["Family", "Animation"] } },

    { "id": "like-inception", "category": "reference", "turns": ["movies like Inception"], "expect": { "clarify": false, "anyGenre": ["Science Fiction", "Action", "Thriller", "Mystery"], "excludeTitles": ["Inception"] } },
    { "id": "inception-relaxing", "category": "reference", "turns": ["like Inception but more relaxing"], "expect": { "clarify": false, "excludeTitles": ["Inception"], "toneConflict": ["Horror", "War", "Crime"] } },
    { "id": "like-the-office", "category": "reference", "turns": ["shows like The Office"], "expect": { "clarify": false, "format": "tv", "anyGenre": ["Comedy"], "excludeTitles": ["The Office"] } },
    { "id": "like-parasite", "category": "reference", "turns": ["films like Parasite"], "expect": { "clarify": false, "anyGenre": ["Thriller", "Drama", "Comedy", "Crime"], "excludeTitles": ["Parasite"] } },

    { "id": "tom-hanks", "category": "talent", "turns": ["movies with Tom Hanks"], "expect": { "clarify": false, "cast": "Tom Hanks" } },
    { "id": "nolan", "category": "talent", "turns": ["Christopher Nolan films"], "expect": { "clarify": false, "director": "Christopher Nolan" } },
    { "id": "keanu-action", "category": "talent", "turns": ["Keanu Reeves action movies"], "expect": { "clarify": false, "cast": "Keanu Reeves", "anyGenre": ["Action"] } },

    { "id": "vague-something-good", "category": "clarify", "turns": ["something good to watch"], "expect": { "clarify": true } },
    { "id": "vague-bored", "category": "clarify", "turns": ["I'm bored, what should I watch?"], "expect": { "clarify": true } },
    { "id": "specific-no-clarify", "category": "clarify", "turns": ["Korean revenge thrillers from the 2000s"], "expect": { "clarify": false, "countries": ["KR"], "yearMin": 2000, "yearMax": 2009 } },

    { "id": "malaysian-choose-heartwarming", "category": "followup", "turns": ["Malaysian movies", { "choose": "warm", "text": "Heartwarming comedies and family stories" }], "expect": { "countries": ["MY"], "toneConflict": ["Horror", "War", "Thriller"] } },
    { "id": "malaysian-add-indonesian", "category": "followup", "turns": ["heartfelt Malaysian movies", "What about Indonesian films too?"], "expect": { "countries": ["MY", "ID"], "coverAllCountries": true, "toneConflict": ["Horror", "War"] } },
    { "id": "korean-narrow-to-series", "category": "followup", "turns": ["Korean thrillers", "only TV series please"], "expect": { "countries": ["KR"], "format": "tv" } },
    { "id": "japanese-to-korean", "category": "followup", "turns": ["Japanese horror movies", "Actually, make it Korean instead"], "expect": { "countries": ["KR"], "anyGenre": ["Horror"] } },
    { "id": "scifi-add-90s", "category": "followup", "turns": ["sci-fi movies", "just ones from the 90s"], "expect": { "yearMin": 1990, "yearMax": 1999, "anyGenre": ["Science Fiction", "Sci-Fi"] } },
    { "id": "horror-less-scary", "category": "followup", "turns": ["horror movies", "something less scary and more funny"], "expect": { "anyGenre": ["Comedy"] } },
    { "id": "hard-pivot-family", "category": "followup", "turns": ["Korean thrillers", "Forget that. I want animated family movies"], "expect": { "anyGenre": ["Animation", "Family"], "avoidCountries": ["KR"], "toneConflict": ["Thriller", "Horror", "Crime"] } },
    { "id": "comedy-then-no-romance", "category": "followup", "turns": ["comedy movies", "no romance please"], "expect": { "excludeGenres": ["Romance"], "anyGenre": ["Comedy"] } },
    { "id": "gritty-choose-crime", "category": "followup", "turns": ["something gritty", { "choose": "crime", "text": "Gritty crime thrillers and mysteries" }], "expect": { "anyGenre": ["Crime", "Thriller", "Mystery"], "toneConflict": ["Family", "Animation"] } },
    { "id": "french-more-recent", "category": "followup", "turns": ["French comedies", "something more recent"], "expect": { "countries": ["FR"], "yearMin": 2015, "anyGenre": ["Comedy"] } },
    { "id": "spanish-add-portuguese", "category": "followup", "turns": ["Spanish-language crime series", "include Portuguese-language ones too"], "expect": { "languages": ["es", "pt"], "coverAllLanguages": true, "format": "tv" } },
    { "id": "hanks-only-comedies", "category": "followup", "turns": ["movies with Tom Hanks", "only the comedies"], "expect": { "cast": "Tom Hanks", "anyGenre": ["Comedy"] } },
    { "id": "horror-this-month-choose", "category": "followup", "turns": ["horror movies released this month", { "choose": "", "text": "Supernatural scares" }], "expect": { "yearMin": 2026, "anyGenre": ["Horror"], "minResults": 3 } }
  ]
}
